<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cx-dashboard.wb-dbw-auto-import</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/user/Documents/ПРОЕКТЫ/local/cx-dashboard/scripts/wb_dbw_auto_import_mac.sh</string>
    </array>

    <!-- раз в минуту, пока Mac включён -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/user/Library/Logs/wb-dbw-auto-import.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/Library/Logs/wb-dbw-auto-import.log</string>
</dict>
</plist>
